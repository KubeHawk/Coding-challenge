          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"spring-boot\"}[1m])) by (le, uri))",
          "legendFormat": "p95 - {{uri}}",
          "refId": "B"
        }
      ],
      "title": "Request Latency (p99 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
